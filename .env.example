# Copy this file to .env and fill in the keys you have. All are FREE and OPTIONAL:
# the platform works without them (Open-Meteo needs no key; the network comes from OpenStreetMap).

# Meteocat XEMA station observations — request a key at https://apidocs.meteo.cat
METEOCAT_API_KEY=

# AEMET OpenData — request a key at https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

# TMB Developer (official GTFS) — register and create an app at https://developer.tmb.cat
TMB_APP_ID=
TMB_APP_KEY=
